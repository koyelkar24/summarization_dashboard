# Select "ollama" or "gemini" in the app sidebar.
AI_BACKEND=ollama

# Local Ollama settings
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Gemini cloud settings (needed only when selecting Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Transcription settings
WHISPER_MODEL_SIZE=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Optional: folder containing ffmpeg and ffprobe if they are not on PATH
FFMPEG_LOCATION=

# Optional YouTube authentication
YOUTUBE_COOKIES_FILE=
# Alternatively, provide the cookies.txt contents directly:
YOUTUBE_COOKIES_CONTENT=
